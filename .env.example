# Canvas Course Manager — Environment Variables
# Copy this file to .env and fill in your values, then:
#   export $(cat .env | xargs)
# Or source it directly:
#   set -a; source .env; set +a

# Required: Your Canvas API token
# Generate at: https://<your-canvas-instance>/profile/settings → "New Access Token"
CANVAS_API_TOKEN=your_canvas_api_token_here

# Required: Your Canvas instance API URL (include /api/v1)
CANVAS_API_URL=https://canvas.instructure.com/api/v1

# Optional: Local directory root for the file browser panel
LOCAL_ROOT=~/Desktop
